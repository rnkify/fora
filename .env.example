# ============================================================
# FORA — ENVIRONMENT TEMPLATE
# Copy this file to .env for local development.
# Never commit .env.
# ============================================================

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=
APP_URL=http://127.0.0.1:8000
PRIMARY_DOMAIN=
ALLOWED_HOSTS=127.0.0.1,localhost

# Database
DATABASE_URL=

# Email
EMAIL_PROVIDER=console
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=
SALES_EMAIL=
SUPPORT_EMAIL=

# Analytics
ENABLE_ANALYTICS=false
ANALYTICS_PROVIDER=disabled
ANALYTICS_ID=

# Billing
ENABLE_BILLING=false
PAYMENT_PROVIDER=disabled
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional product capabilities
ENABLE_BLOG=false
ENABLE_CLIENT_PORTAL=false
ENABLE_BOOKING=false
ENABLE_AI_FEATURES=false
ENABLE_DIGITAL_PRODUCTS=false

# AI provider — disabled in Fora V1 by default
AI_PROVIDER=disabled
AI_API_KEY=

# Business notifications
INQUIRY_NOTIFICATION_EMAIL=
CSRF_TRUSTED_ORIGINS=
WEB_CONCURRENCY=2
PORT=8000
SECURE_SSL_REDIRECT=true
